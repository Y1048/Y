+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+
+class ShutdownTest(unittest.TestCase):
+    def test_detach_before_drain_and_report_failure(self):
+        source = Path(__file__).with_name('twist2_mink_cycle_trial.cpp').read_text()
+        start = source.index('  void finish_response_log(){')
+        end = source.index('\n  void handoff_and_activate()', start)
+        method = source[start:end]
+        fixture = r'''
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <functional>
+#include <cassert>
+struct RealResponseLog { std::function<void()> callback; void Finish(){callback();} };
+struct Controller {
+ std::mutex write_cycle_mutex_;
+ std::unique_ptr<RealResponseLog> response_log_;
+ bool response_log_failed_=false;
+METHOD
+};
+int main(){
+ Controller c; bool drained=false;
+ c.response_log_=std::make_unique<RealResponseLog>();
+ c.response_log_->callback=[&](){
+   assert(!c.response_log_);
+   assert(c.write_cycle_mutex_.try_lock());c.write_cycle_mutex_.unlock();drained=true;
+ };
+ c.finish_response_log();assert(drained);c.finish_response_log();
+ c.response_log_failed_=true;
+ bool refused=false;try{c.finish_response_log();}catch(const std::runtime_error&){refused=true;}
+ assert(refused);
+}
+'''.replace('METHOD', method)
