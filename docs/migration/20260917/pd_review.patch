@@ -0,0 +1,11 @@
+#pragma once
+// Pure decision state: faults cannot manufacture an operator shutdown request.
+class PlannedUdpShutdown {
+ bool requested_=false;
+public:
+ void Request() noexcept { requested_=true; }
+ bool Requested() const noexcept { return requested_; }
+ bool MayHandoff(bool return_ready,bool target_committed,bool fault) const noexcept {
+  return requested_ && return_ready && target_committed && !fault;
+ }
+};
