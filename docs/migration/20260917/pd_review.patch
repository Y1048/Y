+#include "planned_udp_shutdown.hpp"
+#include <cassert>
+int main(){
+ PlannedUdpShutdown gate;
+ assert(!gate.MayHandoff(true,true,false)); // pinch/fault alone is not shutdown
+ gate.Request();gate.Request();
+ assert(!gate.MayHandoff(false,true,false));
+ assert(!gate.MayHandoff(true,false,false));
+ assert(!gate.MayHandoff(true,true,true));
+ assert(gate.MayHandoff(true,true,false));
+}
