  },
  "selection_rule": "Tune on train episodes only. Evaluate the final frozen candidate once on validation. Any candidate changed after seeing validation is a new study and requires a new held-out split.",
  "scope": "simulation only; thresholds are research gates, not G1 hardware safety approval"
